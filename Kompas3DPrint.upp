charset "UTF-8-BOM";

uses
	CtrlLib,
	Kompas3DPrint/KompasAPI;

library(WIN32) "kernel32 user32 advapi32 shell32 winmm";

options(WIN32) -DKAPI5;

options(WIN32) -DKAPI7;

options(UNIX) -DKSAPI;

file
	Kompas3DPrint.cpp,
	Resources.h,
	Kompas3DPrint.h,
	Kompas3DPrint.rc charset "windows-1251" highlight cpp,
	Layouts.lay,
	Command readonly separator,
	Command/Rack.hpp,
	Command/Gear.hpp,
	Command/Settings.hpp,
	Command/AboutDlg.hpp,
	Command/Export.hpp charset "UTF-8",
	Command/Threads.hpp,
	Command/StandardParts.hpp;

mainconfig
	"Kompas3DPrint.rtw" = "GUI DLL";

